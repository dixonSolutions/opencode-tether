{
  "name": "opencode-tether",
  "short_name": "tether",
  "description": "Unofficial, native-feeling remote interface for opencode",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#0b0a0a",
  "background_color": "#0b0a0a",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New session", "url": "/?new=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Remotes", "url": "/?remotes=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}

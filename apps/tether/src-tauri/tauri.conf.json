{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "opencode-tether",
  "version": "0.1.0",
  "identifier": "ai.opencode.tether",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "opencode-tether",
        "width": 1180,
        "height": 820,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0b0a0a",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Unofficial native remote for opencode",
    "longDescription": "opencode-tether is an unofficial, hobby-project remote interface for opencode. Connect to local or remote opencode hosts, manage sessions, and follow agent output from a native app.",
    "copyright": "MIT licensed. Unofficial project; opencode is a separate project.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
